# ── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── MongoDB Atlas ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT Secrets (generate with: openssl rand -base64 48) ──────
JWT_ACCESS_SECRET=change_me_use_openssl_rand_base64_48
JWT_REFRESH_SECRET=change_me_use_openssl_rand_base64_48
JWT_EMAIL_SECRET=change_me_use_openssl_rand_base64_48
JWT_RESET_SECRET=change_me_use_openssl_rand_base64_48
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_EMAIL_EXPIRY=1d
JWT_RESET_EXPIRY=1h

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Email (Gmail SMTP) ────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=GlowRoot

# ── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.com

# ── CORS (comma-separated, no trailing slash) ─────────────────
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# ── Admin Seed (used by: npm run seed:admin) ──────────────────
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=ChangeThisImmediately@123
ADMIN_NAME=Super Admin

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
