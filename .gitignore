# Dependencies
node_modules/
**/node_modules/

# Environment files — NEVER commit real .env files
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env
# .env.example IS safe to commit (contains no real secrets)
!.env.example
!backend/.env.example
!frontend/.env.example

# Build outputs
dist/
build/
.vite/

# Uploads (local disk fallback)
backend/uploads/
uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/
.nyc_output/

# Misc
.cache/
*.tgz
